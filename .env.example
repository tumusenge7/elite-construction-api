# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/elite_construction

# JWT
JWT_SECRET=change_this_to_a_random_secret_key
JWT_EXPIRES_IN=7d

# Client URL
CLIENT_URL=http://localhost:5173

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@eliteconstruction.com

# AI Provider (optional)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo

# Maps (optional)
MAPS_API_KEY=
MAPS_PROVIDER=leaflet

# Payment (future)
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# WhatsApp (optional)
WHATSAPP_NUMBER=
WHATSAPP_API_KEY=

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
